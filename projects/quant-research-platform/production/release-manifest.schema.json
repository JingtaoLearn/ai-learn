{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantresearch.local/schemas/production-release-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "production_api_image_digest",
    "source_commit",
    "source_tree_sha256",
    "dependency_lock_sha256",
    "effective_compose_config_sha256",
    "provider_contract_sha256",
    "api_contract_sha256"
  ],
  "properties": {
    "schema": {"const": "quantresearch-production-release/v1"},
    "production_api_image_digest": {"$ref": "#/$defs/sha256"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
    "effective_compose_config_sha256": {"$ref": "#/$defs/sha256"},
    "provider_contract_sha256": {"$ref": "#/$defs/sha256"},
    "api_contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
