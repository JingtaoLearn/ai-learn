# zhlearn: serving app
QUANT_PORT=18090
QUANT_PUBLIC_URL=https://quant.ai.jingtao.fun
AUTH_SHARED_SECRET=change-me            # shared with ms-login.ai.jingtao.fun
QUANT_SESSION_SECRET=change-me          # random 32+ bytes
QUANT_ALLOWED_EMAILS=you@example.com    # comma-separated
QUANT_API_TOKEN=change-me               # bearer token for Hermes cron jobs
QUANT_WORKER_URL=http://127.0.0.1:18095 # training worker via SSH tunnel; empty = run locally
QUANT_WORKER_TOKEN=change-me
