QUANT_ENVIRONMENT=production
QUANT_AUTH_MODE=sso
QUANT_STATE_ROOT=/home/feng/quant-platform/state/platform
QUANT_PROJECT_ROOT=/home/feng/quant-platform/current
QUANT_PUBLIC_URL=https://quant.ai.jingtao.fun
QUANT_ALLOWED_HOSTS=quant.ai.jingtao.fun
QUANT_SSO_LOGIN_URL=https://ms-login.ai.jingtao.fun/auth/login
QUANT_SSO_AUDIENCE=https://quant.ai.jingtao.fun/auth/callback
QUANT_SSO_CALLBACK_URL=https://quant.ai.jingtao.fun/auth/callback
QUANT_ALLOWED_EMAILS_FILE=/home/feng/.config/quant-research-allowed-emails.txt
QUANT_SECURE_COOKIES=true
QUANT_FORWARDED_ALLOW_IPS=127.0.0.1
QUANT_RUNNER_IMAGE=<registry/image@sha256:replace-with-immutable-digest>
AUTH_SHARED_SECRET=<same-random-secret-configured-on-ms-login>
QUANT_SESSION_SECRET=<independent-random-session-signing-secret>
